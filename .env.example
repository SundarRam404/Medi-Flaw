# ---- Database (Neon: copy the connection string from the Neon dashboard) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ---- Language model for the Ask page (console.groq.com -> API Keys) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# backup if Groq is down: run `ollama pull llama3.1:8b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Email alerts (Gmail: Google Account -> Security -> App passwords). Leave empty = alerts saved on the site only ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
FOLLOWUP_DAYS=3

# ---- Logins created on first start ----
ADMIN_EMAIL=admin@pharmaaudit.in
ADMIN_PASSWORD=admin123
DEMO_EMAIL=demo@pharmaaudit.in
DEMO_PASSWORD=demo123

# ---- Security (change both to long random text) ----
SECRET_KEY=change-this-to-a-long-random-string-of-32-plus-chars
PIPELINE_KEY=pharmaaudit-pipeline-key

# ---- Links ----
APP_URL=http://localhost:3000
# n8n "Run now" webhook (name must NOT start with N8N_, n8n reads those). Leave empty and the Run now button runs the pipeline on the backend directly.
RUN_NOW_WEBHOOK_URL=http://localhost:5678/webhook/pharmaaudit-run
# backup scheduler inside the backend (only if you are NOT using n8n)
ENABLE_SCHEDULER=0
